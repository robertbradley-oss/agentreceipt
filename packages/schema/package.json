{
  "name": "@agentreceipt/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema and validator for AgentReceipt v0.1 receipts.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./receipt.v0.1.schema.json": "./schemas/receipt.v0.1.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/schema.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0"
  }
}
