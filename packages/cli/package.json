{
  "name": "@agentreceipt/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local command-line workflow for AgentReceipt.",
  "bin": {
    "agentreceipt": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentreceipt/codex-adapter": "workspace:*",
    "@agentreceipt/runback": "workspace:*",
    "@agentreceipt/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0"
  }
}
